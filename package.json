{
  "name": "jonah-fleet",
  "version": "1.3.0",
  "description": "Standalone autonomous agent fleet with Symphony orchestration, claim protocols, and continuous improvement loops",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jonah-fleet": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:evals": "vitest run tests/evals.test.ts tests/contribute.test.ts tests/sync-workflow.test.ts",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\""
  },
  "keywords": [
    "agents",
    "antigravity",
    "symphony",
    "autowork",
    "code-review",
    "llm-orchestration"
  ],
  "author": "Julien Durandeu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliendurandeu/jonah-fleet.git"
  },
  "homepage": "https://github.com/juliendurandeu/jonah-fleet#readme",
  "bugs": {
    "url": "https://github.com/juliendurandeu/jonah-fleet/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "files": [
    "dist",
    "templates",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
