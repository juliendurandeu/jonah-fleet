{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JonahFleetManifest",
  "description": "Configuration manifest for Jonah Fleet autonomous agents",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "The pinned fleet version or semver range"
    },
    "preset": {
      "type": "string",
      "enum": ["minimal", "standard", "full", "custom"],
      "default": "standard",
      "description": "Selected routine bundle preset"
    },
    "routines": {
      "type": "object",
      "properties": {
        "autowork": { "type": "boolean" },
        "peer-review": { "type": "boolean" },
        "optimizer": { "type": "boolean" },
        "issues-housekeeping": { "type": "boolean" },
        "dependency-update-security-check": { "type": "boolean" },
        "product-planning": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Granular routine toggles"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of core engineering skills to install/sync"
    },
    "models": {
      "type": "object",
      "properties": {
        "default": { "type": "string", "description": "Default fallback model for all routines" },
        "autowork": { "type": "string", "description": "Model identifier for Autowork (e.g. gemini-3.7-flash-high)" },
        "peer-review": { "type": "string", "description": "Model identifier for Peer Review (e.g. gemini-3.7-flash-high)" },
        "optimizer": { "type": "string", "description": "Model identifier for Prompt Optimizer (e.g. gemini-3.7-flash-high)" },
        "issues-housekeeping": { "type": "string", "description": "Model identifier for Issues Housekeeping (e.g. gemini-3.7-flash)" },
        "dependency-update-security-check": { "type": "string", "description": "Model identifier for Dependency Update Check (e.g. gemini-3.7-flash)" },
        "product-planning": { "type": "string", "description": "Model identifier for Product Planning (e.g. gemini-3.7-flash-high)" }
      },
      "additionalProperties": false,
      "description": "Per-routine model and reasoning effort profiles"
    },
    "budgets": {
      "type": "object",
      "properties": {
        "weeklyTokens": {
          "type": "number",
          "description": "Weekly token budget limit across all routines in the fleet"
        },
        "maxIterations": {
          "type": "object",
          "properties": {
            "default": { "type": "number" },
            "autowork": { "type": "number" },
            "peer-review": { "type": "number" },
            "optimizer": { "type": "number" },
            "issues-housekeeping": { "type": "number" },
            "dependency-update-security-check": { "type": "number" },
            "product-planning": { "type": "number" }
          },
          "additionalProperties": false,
          "description": "Maximum tool call iterations per routine run"
        },
        "timeoutMinutes": {
          "type": "object",
          "properties": {
            "default": { "type": "number" },
            "autowork": { "type": "number" },
            "peer-review": { "type": "number" },
            "optimizer": { "type": "number" },
            "issues-housekeeping": { "type": "number" },
            "dependency-update-security-check": { "type": "number" },
            "product-planning": { "type": "number" }
          },
          "additionalProperties": false,
          "description": "Timeout in minutes per routine run"
        }
      },
      "additionalProperties": false,
      "description": "Budget limits for token spend, iteration caps, and execution timeouts"
    },
    "repositories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of fleet repositories tracked for multi-repo monitoring"
    },
    "autoUpdate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "channel": { "type": "string", "enum": ["stable", "latest"], "default": "stable" }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "preset", "routines", "skills"],
  "additionalProperties": false
}
